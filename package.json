{
  "//": "Antigravity test comment",
  "name": "balanced-digital-children",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:e2e": "detox test",
    "test:e2e:offline": "detox test tests/e2e/ --testNamePattern='offline'",
    "test:e2e:session": "detox test tests/e2e/ --testNamePattern='session'",
    "test:e2e:pin-recovery": "detox test tests/e2e/ --testNamePattern='PIN|Onboarding'",
    "test:e2e:clock-bypass": "detox test tests/e2e/ --testNamePattern='Bypass|Clock'",
    "seed:reports": "npx ts-node scripts/seed-reports.ts",
    "seed:verify": "npx ts-node scripts/seed-verify-cli.ts",
    "db:migrate": "npx ts-node scripts/apply-migration.ts",
    "test:content-schema": "jest tests/integration/contentSchema.test.ts --no-coverage",
    "seed:content": "npx ts-node scripts/seed-content.ts",
    "test:content-seed": "jest tests/integration/contentSeed.test.ts --no-coverage",
    "test:game-screen": "jest tests/unit/game/gameScreen.test.tsx --no-coverage",
    "test:game-screen-integration": "jest tests/integration/gameScreen.test.ts --no-coverage",
    "migrate:rls-admin": "npx ts-node scripts/apply-rls-admin.ts",
    "test:rls-policies": "jest tests/integration/rlsPolicies.test.ts --no-coverage",
    "test:admin-crud": "jest tests/integration/adminCrud.test.ts --no-coverage",
    "migrate:validation-lifecycle": "npx ts-node scripts/apply-validation-lifecycle.ts",
    "test:content-validation": "jest tests/integration/contentValidation.test.ts tests/unit/contentValidationRules.test.ts --no-coverage",
    "migrate:two-device": "npx ts-node scripts/apply-two-device-schema.ts",
    "test:pairing": "jest tests/integration/pairing.test.ts --no-coverage",
    "test:pairing-unit": "jest tests/unit/pairingToken.test.ts --no-coverage",
    "migrate:child-pairing": "npx ts-node scripts/apply-child-pairing-schema.ts",
    "test:child-pairing": "jest tests/integration/childPairing.test.ts --no-coverage",
    "test:child-pairing-unit": "jest tests/unit/childPairingToken.test.ts --no-coverage",
    "migrate:pin-auth": "npx ts-node scripts/apply-pin-auth-schema.ts",
    "test:pin-auth": "jest tests/integration/pinAuth.test.ts --no-coverage",
    "test:pin-auth-unit": "jest tests/unit/pinAuth.test.ts --no-coverage",
    "test:realtime-channel": "jest --testPathPattern=tests/integration/realtimeChannel --runInBand",
    "test:live-sessions": "jest --testPathPattern=tests/integration/liveSessionReports --runInBand --forceExit"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~55.0.11",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@supabase/supabase-js": "^2.106.2",
    "expo": "~55.0.5",
    "expo-av": "^16.0.8",
    "expo-battery": "~55.0.13",
    "expo-camera": "~55.0.19",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.15",
    "expo-file-system": "~55.0.22",
    "expo-font": "~55.0.8",
    "expo-linear-gradient": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.16",
    "expo-sharing": "~55.0.20",
    "expo-sqlite": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "js-sha256": "^0.11.1",
    "react": "19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "0.7.4",
    "react-native-youtube-iframe": "^2.4.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "babel-jest": "^29.7.0",
    "eslint": "^10.4.0",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.4",
    "supabase": "^2.105.0",
    "test-renderer": "^1.2.0",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.2"
  },
  "private": true
}
